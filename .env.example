# ==============================================================================
# NxtQuik Environment Configuration
# ==============================================================================
# Copy this file to .env (or configure in your VPS hosting environment).
# Note: Variables prefixed with VITE_ are embedded into client bundles at build time.
# Server-only variables (e.g., RESEND_API_KEY) are kept strictly server-side.
# ==============================================================================

# Public Canonical Site URL (used for canonical links, sitemaps, OpenGraph, JSON-LD)
VITE_SITE_URL=https://nxtquik.com

# Email Delivery (Resend API key to send enquiry emails to nxtquik@gmail.com)
# Get your API key at https://resend.com
RESEND_API_KEY=

# Optional Webhook Integration (Slack, Discord, Zapier, CRM webhook endpoint)
CONTACT_WEBHOOK_URL=

# Node.js Server Port (Optional, defaults to 8080 or port assigned by VPS environment)
PORT=8080
