# ==============================================================================
# NxtQuik Environment Configuration (Vite React Static SPA)
# ==============================================================================
# Copy this file to .env (or .env.production) if you need custom values.
# Note: Variables prefixed with VITE_ are embedded into client bundles at build time.
# ==============================================================================

# Public Canonical Site URL (used for canonical links, sitemaps, OpenGraph, JSON-LD)
VITE_SITE_URL=https://www.nxtquik.com

# Optional Custom Contact Form Webhook (Slack, Discord, Zapier, Make, or custom API)
# If left empty, contact form submissions securely dispatch to nxtquik@gmail.com
VITE_CONTACT_WEBHOOK_URL=
